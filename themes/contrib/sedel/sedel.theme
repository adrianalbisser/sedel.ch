// Add your custom theme override functions here.

/**
 * Implements hook_theme_suggestions_HOOK_alter() for mimemail_message.
 */
function sedel_theme_suggestions_mimemail_message_alter(array &$suggestions, array $variables) {
  // Scope the document shell to the weekly newsletter, including test mails.
  // Other Simplenews templates and subscription messages keep their own shell.
  if ($variables['module'] === 'simplenews' && strpos((string) $variables['body'], 'class="sedel-newsletter"') !== FALSE) {
    $suggestions[] = 'mimemail_message__sedel_newsletter';
  }
}

/**
 * Implements hook_preprocess_mimemail_message().
 */
function sedel_preprocess_mimemail_message(array &$variables) {
  if ($variables['module'] !== 'simplenews' || strpos((string) $variables['body'], 'class="sedel-newsletter"') === FALSE) {
    return;
  }

  // View headers and flyer markup come from Drupal configuration. Add the
  // essential image rules here so they also work without embedded stylesheets.
  $document = \Drupal\Component\Utility\Html::load((string) $variables['body']);
  foreach ($document->getElementsByTagName('img') as $image) {
    $style = $image->getAttribute('style');
    // Preserve a logo's intended size while allowing it to shrink on mobile.
    if (!$image->hasAttribute('width') && !preg_match('/(?:^|;)\s*width\s*:/i', $style) && preg_match('/max-width\s*:\s*(\d+(?:\.\d+)?)px/i', $style, $matches)) {
      $style = rtrim($style, '; ') . '; width:' . $matches[1] . 'px';
    }
    $image->setAttribute('style', rtrim($style, '; ') . '; max-width:100% !important; height:auto !important; display:block; border:0; margin-left:auto; margin-right:auto;');
  }
  $variables['body'] = \Drupal\Core\Render\Markup::create(\Drupal\Component\Utility\Html::serialize($document));
}

/**
 * Implements hook_preprocess_block()
 */
function sedel_preprocess_block(&$variables) {
  if ($variables['plugin_id'] == 'commerce_cart') {
    if ($variables['content']['#count'] == 0) {
      $variables['attributes']['class'][] = 'visually-hidden';
    }
  }
}


