{# Mime Mail supplies the document head and responsive CSS for this fragment. #}
{% if format == 'html' %}
<div class="sedel-newsletter" style="width:100%; margin:0; padding:0;">
  <center>
    <!-- Visually Hidden Preheader Text : BEGIN -->
    <div style="display:none;font-size:1px;line-height:1px;max-height:0px;max-width:0px;opacity:0;overflow:hidden;mso-hide:all;font-family: sans-serif;">
        Der Newsletter der ILM Sedel präsentiert dir Woche für Woche die aktuellen Veranstaltungen im Sedel.
    </div>
    <!-- Visually Hidden Preheader Text : END -->

    <table role="presentation" width="100%" border="0" cellpadding="0" cellspacing="0" bgcolor="#FFFFFF">
        <tr>
            <td align="center" valign="top">

              <!--[if mso]><table width="680" cellpadding="0" cellspacing="0" border="0" align="center"><tr><td><![endif]-->
              <table role="presentation" width="100%" cellpadding="0" cellspacing="0" border="0" class="wrapper" bgcolor="#000000" style="width:100%; max-width:680px; table-layout:fixed; border-collapse:collapse;">
  <tr>
    <td align="center" valign="top">

      <!--[if mso]><table width="600" cellpadding="0" cellspacing="0" border="0" align="center"><tr><td><![endif]-->
      <table role="presentation" width="100%" align="center" cellpadding="0" cellspacing="0" border="0" class="container" bgcolor="#000000" style="width:100%; max-width:600px; table-layout:fixed; border-collapse:collapse;">
        <tr>
          <td class="mobile" align="left" valign="top" style="padding:0 16px; color:#FFFFFF; font-family:Heebo,Helvetica,Arial,sans-serif; font-size:16px; line-height:24px; overflow-wrap:break-word;">

            {{ build }}

            </td>
          </tr>
          <tr>
            <td class="mobile" align="center" valign="top" style="padding:0 16px; color:#FFFFFF; font-family:Heebo,Helvetica,Arial,sans-serif; font-size:16px; line-height:24px; overflow-wrap:break-word;">
    {% if not opt_out_hidden %}
                {% if format == 'html' %}

                    <p class="newsletter-footer" style="font-size:14px; line-height:2; border-top:1px solid #FFFFFF;  margin-top:32px; padding-top:32px; color:#FFFFFF;font-family: 'Heebo','Helvetica', sans-serif;">ILM Sedel  |  Sedelhof 2  |  CH-6020 Emmenbrücke  |  +41 (0)41 508 19 51 <br />
                      <a style="text-decoration:none;"href="https://www.sedel.ch"><span style="color:#dc4731;">www.sedel.ch</span></a>  | <a style="text-decoration:none;" href="mailto:sedel@sedel.ch"><span style="color:#dc4731;">sedel@sedel.ch</span></a><br />

                      <br />
                      Du erhältst diesen Newsletter, weil du ihn auf sedel.ch abonniert hast. <br /> <a style="text-decoration:none;" href="[simplenews-subscriber:unsubscribe-url]"><span style="color:#dc4731;">Ich möchte mich vom Newsletter abmelden.</span></a><br />

                      <br />
                      <img width="288" style="display:block; width:288px; max-width:100%; height:auto; border:0; margin:0 auto;" alt="Going underground" src="https://sedel.ch/sites/default/files/inline-images/footer_2.png">
                    </p>

                {% else %}
                     {{ unsubscribe_text }} : [simplenews-subscriber:unsubscribe-url]
                {% endif %}
            {% endif %}



          </td>
        </tr>
      </table>
      <!--[if mso]></td></tr></table><![endif]-->

    </td>
  </tr>
</table>
              <!--[if mso]></td></tr></table><![endif]-->

            </td>
        </tr>
    </table>
  </center>
</div>
{% else %}
{{ build }}
{% if not opt_out_hidden %}
{{ unsubscribe_text }} : [simplenews-subscriber:unsubscribe-url]
{% endif %}
{% endif %}
